[[63,1,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Open the trim hinges using a suitable tool.</p><p>2. Open the side Air Bag module safety band.</p><p>3. Release the cover and remove it.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/4166.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[63,1,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>- Fit the cover on the side panel upholstery.</p><p>- Close the side Air Bag module safety band.</p><p>- Close the cover hinges.</p>"]]