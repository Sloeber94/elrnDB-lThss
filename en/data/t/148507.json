[[63,1,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>- Disconnect the negative battery terminal.</p><p>1. Turn the headlamp locking device in the direction shown by the arrow.</p><p>2. Disconnect the electrical connector (2a) and remove the headlamp (2b) from the housing.</p><div class=\"table\"><table><tr><th><img class=\"icon\" src=\"../media/771.jpg\" alt=\"\" loading=\"lazy\"></th><th><p>Description</p></th><th><p>Connector</p></th></tr><tr><td><p>2a</p></td><td><p>Left headlamp</p></td><td><p>F010</p></td></tr></table></div><div class=\"table\"><table><tr><th><img class=\"icon\" src=\"../media/771.jpg\" alt=\"\" loading=\"lazy\"></th><th><p>Description</p></th><th><p>Connector</p></th></tr><tr><td><p>2a</p></td><td><p>Right headlamp</p></td><td><p>F011</p></td></tr></table></div><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2150.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[63,1,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>1. Connect the electrical connector (1a) and fit the headlamp (2b) in the housing.</p><div class=\"table\"><table><tr><th><img class=\"icon\" src=\"../media/771.jpg\" alt=\"\" loading=\"lazy\"></th><th><p>Description</p></th><th><p>Connector</p></th></tr><tr><td><p>1a</p></td><td><p>Left headlamp</p></td><td><p>F010</p></td></tr></table></div><div class=\"table\"><table><tr><th><img class=\"icon\" src=\"../media/771.jpg\" alt=\"\" loading=\"lazy\"></th><th><p>Description</p></th><th><p>Connector</p></th></tr><tr><td><p>1a</p></td><td><p>Right headlamp</p></td><td><p>F011</p></td></tr></table></div><p>2. Turn the headlamp locking device in the direction shown by the arrow.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2151.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[63,1,0,"<p>- Connect the negative battery terminal.</p>"]]