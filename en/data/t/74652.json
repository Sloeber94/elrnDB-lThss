[[3,1,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Undo and remove the engine oil filler plug.</p><p>2. Undo the bolts (2a) and remove the ignition coil cover on the cylinder head (2b).</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/266.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[3,1,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>- Place the ignition coil cover on the cylinder head back in its housing and secure it using the bolts.</p><div class=\"table\"><table><tr><th><img class=\"icon\" src=\"../media/774.jpg\" alt=\"\" loading=\"lazy\"></th><th><p>Value - daNm</p></th><th><p>Fastening</p></th><th><p>Component</p></th><th><p>Ø</p></th></tr><tr><td><p>.</p></td><td><p>0.9</p></td><td><p>Bolt</p></td><td><p>IGNITION COIL/REEL COVER/S</p></td><td><p>M6</p></td></tr></table></div><p>- Fit the engine oil filler plug.</p>"],[12,1,0,"<p>- Operation not available</p>"]]