[[63,1,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p><a href=\"#/114373\">See in Op. 7050A20 Single rear seat cushion - R.R.</a></p><p>-</p><p>1. Release the cover along the rear seat cushion perimeter.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/4047.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[63,1,0,"<p>1. Separate the frame (1a) from the cushion assembly (1b).</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/4048.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[63,1,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>- Fit the frame on the rear seat cushion.</p><p>- Fit the surround for the cover along the entire perimeter of the rear seat cushion frame.</p>"]]