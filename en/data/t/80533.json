[[63,1,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>- Disconnect the negative battery terminal.</p><p>1. Release the shield (1a) and undo the bolt (1b) fixing the front seat belt to the seat.</p><p>2. Remove the seat belt from the housing.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/1180.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[63,1,0,"<p>1. Place the front seat (1a) in the forwards end of travel position and undo the fixing bolts (1b).</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/1182.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[63,1,0,"<p>- Move the front seat backwards into the end of travel position.</p><p>1. Undo the bolts fixing the seat to the bodyshell.</p><p>2. Disconnect the electrical connections for the seat.</p><div class=\"table\"><table><tr><th><img class=\"icon\" src=\"../media/771.jpg\" alt=\"\" loading=\"lazy\"></th><th><p>Description</p></th><th><p>Connector</p></th></tr><tr><td><p>2</p></td><td><p>Driver&#x27;s seat coupling</p></td><td><p>D070B</p></td></tr></table></div><div class=\"table\"><table><tr><th><img class=\"icon\" src=\"../media/771.jpg\" alt=\"\" loading=\"lazy\"></th><th><p>Description</p></th><th><p>Connector</p></th></tr><tr><td><p>2</p></td><td><p>Passenger seat coupling</p></td><td><p>D071B</p></td></tr></table></div><div class=\"table\"><table><tr><th><img class=\"icon\" src=\"../media/771.jpg\" alt=\"\" loading=\"lazy\"></th><th><p>Description</p></th><th><p>Connector</p></th></tr><tr><td><p>2</p></td><td><p>Driver&#x27;s seat coupling</p></td><td><p>D070C</p></td></tr></table></div><div class=\"table\"><table><tr><th><img class=\"icon\" src=\"../media/771.jpg\" alt=\"\" loading=\"lazy\"></th><th><p>Description</p></th><th><p>Connector</p></th></tr><tr><td><p>2</p></td><td><p>Driver&#x27;s seat coupling</p></td><td><p>D070D</p></td></tr></table></div><div class=\"table\"><table><tr><th><img class=\"icon\" src=\"../media/771.jpg\" alt=\"\" loading=\"lazy\"></th><th><p>Description</p></th><th><p>Connector</p></th></tr><tr><td><p>2</p></td><td><p>Passenger seat coupling</p></td><td><p>D071C</p></td></tr></table></div><div class=\"table\"><table><tr><th><img class=\"icon\" src=\"../media/771.jpg\" alt=\"\" loading=\"lazy\"></th><th><p>Description</p></th><th><p>Connector</p></th></tr><tr><td><p>2</p></td><td><p>Passenger seat coupling</p></td><td><p>D071C</p></td></tr></table></div><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/1187.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[63,1,0,"<p>- Remove the front seat.</p>"],[63,1,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>- Place the seat in position and connect the electrical connectors.</p><div class=\"table\"><table><tr><th><img class=\"icon\" src=\"../media/771.jpg\" alt=\"\" loading=\"lazy\"></th><th><p>Description</p></th><th><p>Connector</p></th></tr><tr><td><p>.</p></td><td><p>Driver&#x27;s seat coupling</p></td><td><p>D070B</p></td></tr></table></div><div class=\"table\"><table><tr><th><img class=\"icon\" src=\"../media/771.jpg\" alt=\"\" loading=\"lazy\"></th><th><p>Description</p></th><th><p>Connector</p></th></tr><tr><td><p>.</p></td><td><p>Passenger seat coupling</p></td><td><p>D071B</p></td></tr></table></div><div class=\"table\"><table><tr><th><img class=\"icon\" src=\"../media/771.jpg\" alt=\"\" loading=\"lazy\"></th><th><p>Description</p></th><th><p>Connector</p></th></tr><tr><td><p>.</p></td><td><p>Driver&#x27;s seat coupling</p></td><td><p>D070C</p></td></tr></table></div><div class=\"ta