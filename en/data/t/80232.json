[[63,1,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>- Open the boot lid.</p><p>1. Use the tool (1a) to release the retaining buttons (1b) and remove the lining (1c).</p><div class=\"table\"><table><tr><th><img class=\"icon\" src=\"../media/770.jpg\" alt=\"\" loading=\"lazy\"></th><th><p>Description</p></th><th><p>Code</p></th><th><p>Function</p></th></tr><tr><td><p>1a</p></td><td><p>Knife</p></td><td><p>1.878.077.000</p></td><td><p>Removing boot lid lining</p></td></tr></table></div><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/1063.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[63,1,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>- Check that the lining is not damaged.</p><p>- Position the lining and fasten it using the retaining buttons.</p>"]]